#!/usr/bin/env node
const args = process.argv.slice(2);
const credits = Number(args[args.indexOf('--max-ai-credits') + 1]);
if (!Number.isFinite(credits) || credits < 30) {
  console.error('Invalid value for --max-ai-credits. Use at least 30 AI credits.');
  process.exitCode = 1;
} else if (args.includes('--deny-tool=*')) {
  console.error('Invalid --deny-tool value. Error: Invalid rule format: *');
  process.exitCode = 1;
} else if (!args.includes('--available-tools=')) {
  console.error('Resident tools must remain disabled.');
  process.exitCode = 1;
} else {
  console.log(JSON.stringify({ action: 'wait', intent: '观察周围' }));
}
